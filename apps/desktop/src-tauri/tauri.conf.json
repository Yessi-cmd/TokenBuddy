{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenBuddy",
  "version": "0.1.0",
  "identifier": "com.tokenbuddy.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TokenBuddy",
        "width": 1100,
        "height": 720,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
