{
  "name": "tokenbuddy",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @tokenbuddy/desktop tauri dev",
    "build": "pnpm --filter @tokenbuddy/desktop tauri build",
    "build:web": "pnpm --filter @tokenbuddy/desktop build",
    "format": "pnpm --filter @tokenbuddy/desktop format && cargo fmt --all",
    "format:check": "pnpm --filter @tokenbuddy/desktop format:check && cargo fmt --all -- --check",
    "lint": "pnpm --filter @tokenbuddy/desktop lint && cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "test": "pnpm --filter @tokenbuddy/desktop test && cargo test --workspace --all-targets",
    "check:rust": "cargo check --workspace --all-targets"
  }
}
